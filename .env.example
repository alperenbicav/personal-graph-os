# Personal Graph OS — environment template.
# Copy to `.env`, fill in the values, and run `uv run python -m personal_graph_os.api`.
# The app loads `.env` automatically on start (existing shell variables always win).
# Every secret here is git-ignored; `.env` and `.env.*` are excluded from version control.

# --- Server ---------------------------------------------------------------
# PGOS_PORT=8000
# PGOS_DB_PATH=./workspace/graph.db
# PGOS_TRUSTED_HOSTS=127.0.0.1,localhost
# PGOS_DEV_CORS=1
# PGOS_DEV_CORS_ORIGINS=http://localhost:5173

# --- Enrichment (chat-completions provider; fail-closed when unset) -------
# PGOS_ENRICHMENT_PROVIDER=http_chat
# PGOS_ENRICHMENT_BASE_URL=https://api.openai.com/v1
# PGOS_ENRICHMENT_API_KEY=
# PGOS_ENRICHMENT_MODEL=gpt-5.6-luna
# PGOS_ENRICHMENT_REASONING_EFFORT=high

# --- Work planning (chat-completions provider; fail-closed when unset) ----
# PGOS_WORK_PLANNING_PROVIDER=http_chat
# PGOS_WORK_PLANNING_BASE_URL=https://api.openai.com/v1
# PGOS_WORK_PLANNING_API_KEY=
# PGOS_WORK_PLANNING_MODEL=gpt-5.6-luna
# PGOS_WORK_PLANNING_REASONING_EFFORT=high

# --- ClickUp ingress (disabled when PGOS_CLICKUP_API_TOKEN is blank) ------
# PGOS_CLICKUP_API_TOKEN=
# PGOS_CLICKUP_BASE_URL=https://api.clickup.com/api/v2

# --- Telegram ingress (kill switch: PGOS_TELEGRAM_ENABLED must be 1) ------
# PGOS_TELEGRAM_ENABLED=1
# PGOS_TELEGRAM_API_TOKEN=
# PGOS_TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
# PGOS_TELEGRAM_API_URL=https://api.telegram.org
