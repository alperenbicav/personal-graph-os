# Only needed for `npm run dev` (Vite dev server) against a separately-hosted backend,
# instead of the same-origin production build served at `/app/`. Start that backend with
# `PGOS_DEV_CORS=1 uv run python -m personal_graph_os.api` so it accepts this origin.
# The bearer token itself is never put here or anywhere in the build — unlock the running
# UI in the browser instead; `pgos-token show` prints the token to enter there.
VITE_API_BASE_URL=http://localhost:8000
